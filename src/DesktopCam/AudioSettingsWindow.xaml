<Window x:Class="DesktopCam.AudioSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="소리 설정 · Desktop CAM" Icon="Assets/DesktopCam.ico"
        Width="560" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" Background="{DynamicResource Bg}"
        ShowInTaskbar="True" Topmost="True" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource KoFont}" FontSize="13" Foreground="{DynamicResource Cream}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style x:Key="BtnSm" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="SegSm" TargetType="RadioButton" BasedOn="{StaticResource Seg}">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontFamily" Value="{StaticResource KoFont}"/>
            <Setter Property="FontSize" Value="{DynamicResource PxL}"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Val" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource PixelFont}"/>
            <Setter Property="FontSize" Value="{DynamicResource PxS}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource CardTitle}">
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource TealDeep}" BorderThickness="{DynamicResource EdgeW}" Background="{DynamicResource Scanlines}">
        <StackPanel Margin="12">
            <!-- 머리 -->
            <Border Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource TealDeep}" BorderThickness="{DynamicResource EdgeW}" Padding="8,5"
                    Margin="0,0,0,10" MouseLeftButtonDown="OnHeaderDown" Cursor="SizeAll">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontFamily="{DynamicResource PixelFont}" FontSize="{DynamicResource PxM}" Foreground="{DynamicResource Teal}" Text="&gt; "/>
                        <TextBlock FontFamily="{DynamicResource PixelFont}" FontSize="{DynamicResource PxM}" Text="MIC FILTER"/>
                    </StackPanel>
                    <Button Style="{StaticResource IconBtn}" Content="X" HorizontalAlignment="Right" MinHeight="24" MinWidth="24" FontSize="{DynamicResource PxS}"
                            Click="OnCloseClick" ToolTip="닫기"/>
                </Grid>
            </Border>

            <!-- 프리셋 -->
            <ContentControl Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Section}"><Run Foreground="{DynamicResource Teal}" Text="&gt; "/>PRESET</TextBlock>
                    <WrapPanel x:Name="PresetPanel"/>
                    <TextBlock x:Name="PresetTip" Style="{StaticResource Label}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </ContentControl>

            <!-- 세부 값 -->
            <ContentControl Style="{StaticResource Card}" Margin="0,10,4,4">
                <Grid x:Name="FxGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="72"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.ColumnSpan="3" Style="{StaticResource Section}"><Run Foreground="{DynamicResource Teal}" Text="&gt; "/>FILTER · EQ</TextBlock>

                    <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="잡음 제거"/>
                    <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" BorderBrush="{DynamicResource Edge}" BorderThickness="{DynamicResource EdgeW}" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="Dn0" GroupName="dn" Style="{StaticResource SegSm}" Content="끔" Tag="0" Checked="OnDenoise"/>
                            <Border Width="2" Background="{DynamicResource Edge}"/>
                            <RadioButton x:Name="Dn1" GroupName="dn" Style="{StaticResource SegSm}" Content="약하게" Tag="1" Checked="OnDenoise"
                                         ToolTip="고르게 깔린 잡음(팬·히스)을 줄입니다"/>
                            <Border Width="2" Background="{DynamicResource Edge}"/>
                            <RadioButton x:Name="Dn2" GroupName="dn" Style="{StaticResource SegSm}" Content="강하게 (AI)" Tag="2" Checked="OnDenoise"
                                         ToolTip="AI(RNNoise)가 목소리만 남깁니다. 잡음이 심할 때"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="말 사이 잡음" Margin="0,8,0,0"/>
                    <Button x:Name="GateBtn" Grid.Row="2" Grid.Column="1" Style="{StaticResource BtnSm}" HorizontalAlignment="Left" Margin="0,8,0,0"
                            Click="OnGate" ToolTip="말하지 않을 때 남은 잡음을 20dB 더 낮춥니다 (게이트)"/>

                    <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="웅웅거림 자르기" Margin="0,10,0,0"/>
                    <Slider x:Name="HpSlider" Grid.Row="3" Grid.Column="1" Style="{StaticResource PixelSlider}" Margin="0,10,8,0"
                            Minimum="0" Maximum="200" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="OnSlider"
                            ToolTip="이 주파수 아래(책상 진동·에어컨 웅웅거림)를 자릅니다"/>
                    <TextBlock x:Name="HpText" Grid.Row="3" Grid.Column="2" Style="{StaticResource Val}" Margin="0,10,0,0"/>

                    <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="저음 150Hz" Margin="0,8,0,0"/>
                    <Slider x:Name="LowSlider" Grid.Row="4" Grid.Column="1" Style="{StaticResource PixelSlider}" Margin="0,8,8,0"
                            Minimum="-6" Maximum="6" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="OnSlider" ToolTip="목소리의 묵직함"/>
                    <TextBlock x:Name="LowText" Grid.Row="4" Grid.Column="2" Style="{StaticResource Val}" Margin="0,8,0,0"/>

                    <TextBlock Grid.Row="5" Style="{StaticResource Label}" Text="중음 800Hz" Margin="0,8,0,0"/>
                    <Slider x:Name="MidSlider" Grid.Row="5" Grid.Column="1" Style="{StaticResource PixelSlider}" Margin="0,8,8,0"
                            Minimum="-6" Maximum="6" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="OnSlider" ToolTip="낮추면 방 울림·코맹맹이 소리가 줄어듭니다"/>
                    <TextBlock x:Name="MidText" Grid.Row="5" Grid.Column="2" Style="{StaticResource Val}" Margin="0,8,0,0"/>

                    <TextBlock Grid.Row="6" Style="{StaticResource Label}" Text="또렷함 3.5kHz" Margin="0,8,0,0"/>
                    <Slider x:Name="PresSlider" Grid.Row="6" Grid.Column="1" Style="{StaticResource PixelSlider}" Margin="0,8,8,0"
                            Minimum="-6" Maximum="6" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="OnSlider" ToolTip="말이 또박또박 들리는 정도"/>
                    <TextBlock x:Name="PresText" Grid.Row="6" Grid.Column="2" Style="{StaticResource Val}" Margin="0,8,0,0"/>

                    <TextBlock Grid.Row="7" Style="{StaticResource Label}" Text="공기감 10kHz" Margin="0,8,0,0"/>
                    <Slider x:Name="AirSlider" Grid.Row="7" Grid.Column="1" Style="{StaticResource PixelSlider}" Margin="0,8,8,0"
                            Minimum="-6" Maximum="6" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="OnSlider" ToolTip="숨소리·고음의 밝기. 너무 올리면 치찰음이 커집니다"/>
                    <TextBlock x:Name="AirText" Grid.Row="7" Grid.Column="2" Style="{StaticResource Val}" Margin="0,8,0,0"/>

                    <TextBlock Grid.Row="8" Style="{StaticResource Label}" Text="크기 고르게" Margin="0,10,0,0"/>
                    <Border Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2" BorderBrush="{DynamicResource Edge}" BorderThickness="{DynamicResource EdgeW}" HorizontalAlignment="Left" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="Cp0" GroupName="cp" Style="{StaticResource SegSm}" Content="끔" Tag="0" Checked="OnCompress"/>
                            <Border Width="2" Background="{DynamicResource Edge}"/>
                            <RadioButton x:Name="Cp1" GroupName="cp" Style="{StaticResource SegSm}" Content="약하게" Tag="1" Checked="OnCompress"/>
                            <Border Width="2" Background="{DynamicResource Edge}"/>
                            <RadioButton x:Name="Cp2" GroupName="cp" Style="{StaticResource SegSm}" Content="강하게" Tag="2" Checked="OnCompress"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Grid.Row="9" Style="{StaticResource Label}" Text="음량 맞추기" Margin="0,8,0,0"/>
                    <Button x:Name="NormBtn" Grid.Row="9" Grid.Column="1" Style="{StaticResource BtnSm}" HorizontalAlignment="Left" Margin="0,8,0,0"
                            Click="OnNormalize" ToolTip="유튜브 기준 음량(-16 LUFS)으로 맞춥니다"/>
                </Grid>
            </ContentControl>

            <!-- 미리 듣기 -->
            <ContentControl Style="{StaticResource Card}" Margin="0,10,4,4">
                <StackPanel>
                    <TextBlock Style="{StaticResource Section}"><Run Foreground="{DynamicResource Teal}" Text="&gt; "/>PREVIEW</TextBlock>
                    <WrapPanel>
                        <Button x:Name="RecTestBtn" Style="{StaticResource BtnSm}" Content="5초 녹음" Click="OnRecordTest" Margin="0,0,4,4"
                                ToolTip="지금 마이크로 5초 동안 말해 보세요"/>
                        <Button x:Name="PlayRawBtn" Style="{StaticResource BtnSm}" Content="원음 듣기" Click="OnPlayRaw" Margin="0,0,4,4" IsEnabled="False"/>
                        <Button x:Name="PlayFxBtn" Style="{StaticResource BtnSm}" Content="적용해서 듣기" Click="OnPlayFx" Margin="0,0,4,4" IsEnabled="False"/>
                        <Button x:Name="StopBtn" Style="{StaticResource BtnSm}" Content="멈춤" Click="OnStopPlay" Margin="0,0,4,4" IsEnabled="False"/>
                    </WrapPanel>
                    <TextBlock x:Name="PreviewText" Style="{StaticResource Label}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="5초 녹음한 뒤 원음과 적용한 소리를 번갈아 들어 보세요. 소리는 기본 출력 장치로 나옵니다."/>
                </StackPanel>
            </ContentControl>

            <!-- NVIDIA Broadcast · 기타 -->
            <ContentControl Style="{StaticResource Card}" Margin="0,10,4,4">
                <StackPanel>
                    <TextBlock Style="{StaticResource Section}"><Run Foreground="{DynamicResource Teal}" Text="&gt; "/>MORE</TextBlock>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="BroadcastText" Style="{StaticResource Label}" TextWrapping="Wrap"/>
                        <Button x:Name="BroadcastBtn" Grid.Column="1" Style="{StaticResource BtnSm}" Content="이 마이크 쓰기" Margin="8,0,0,0"
                                Click="OnUseBroadcast" Visibility="Collapsed"/>
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Label}" Text="원본도 남기기 (처리 전 영상 · 마이크 wav)"/>
                        <Button x:Name="KeepRawBtn" Grid.Column="1" Style="{StaticResource BtnSm}" Click="OnKeepRaw"/>
                    </Grid>
                    <TextBlock x:Name="ToolText" Style="{StaticResource Label}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </ContentControl>
        </StackPanel>
    </Border>
</Window>
