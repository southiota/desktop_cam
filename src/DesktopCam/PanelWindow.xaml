<Window x:Class="DesktopCam.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DesktopCam"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="Desktop CAM" Icon="Assets/DesktopCam.ico"
        Width="440" Height="1080"
        WindowStyle="None" Background="{DynamicResource Bg}"
        ResizeMode="NoResize" ShowInTaskbar="True" Topmost="True"
        FontFamily="{StaticResource KoFont}" FontSize="13" Foreground="{DynamicResource Cream}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- 패널 전체 스크롤바: 확대해서 화면보다 길어질 때만 보인다. 모양 · 색은 App.xaml 기본 스크롤바(14)와 같고 더 두껍게 (20).
             폭(DIP)은 실제 픽셀에 맞게 코드에서 정함 (ApplyRegion) -->
        <sys:Double x:Key="PanelBarW">20</sys:Double>
        <Style x:Key="PanelScrollBar" TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}">
            <Setter Property="Width" Value="{DynamicResource PanelBarW}"/>
            <Setter Property="MinWidth" Value="0"/>
        </Style>
        <!-- 작은 선택 버튼 · 작은 버튼 · ON/OFF -->
        <Style x:Key="SegSm" TargetType="RadioButton" BasedOn="{StaticResource Seg}">
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="{DynamicResource PxS}"/>
        </Style>
        <Style x:Key="BtnSm" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Padding" Value="7,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <!-- 창 목록 줄 안의 버튼: 제목이 넓게 보이도록 좁게 -->
        <Style x:Key="RowBtn" TargetType="Button" BasedOn="{StaticResource BtnSm}">
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="OnOff" TargetType="Button" BasedOn="{StaticResource BtnSm}">
            <Setter Property="FontFamily" Value="{DynamicResource PixelFont}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="{DynamicResource PxS}"/>
            <Setter Property="MinWidth" Value="46"/>
            <Setter Property="MinHeight" Value="28"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Tag" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource PixelFont}"/>
            <Setter Property="FontSize" Value="{DynamicResource PxXS}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Combo" TargetType="ComboBox" BasedOn="{StaticResource PixelCombo}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="28"/>
        </Style>

        <!-- 창 목록 한 줄: 제목 하나만 보이고, 프로그램·크기는 마우스를 올리면 -->
        <DataTemplate x:Key="WinRow" DataType="{x:Type local:WinItem}">
            <Border x:Name="Row" Background="{DynamicResource BgRaised}" BorderBrush="Transparent"
                    BorderThickness="2" Padding="8,2,2,2" Margin="0,0,0,4" ToolTip="{Binding Sub}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="Px" Width="8" Height="8" Margin="0,0,8,0" Background="{DynamicResource Teal}"/>
                    <TextBlock x:Name="Name" Grid.Column="1" Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                    <Button x:Name="TopBtn" Grid.Column="2" Style="{StaticResource RowBtn}" Margin="6,0,0,0" MinWidth="30"
                            Content="위로" Tag="{Binding}" Click="OnTopClick" ToolTip="이 창을 맨 앞으로 (최소화돼 있으면 열고)"/>
                    <Button Grid.Column="3" Style="{StaticResource RowBtn}" Margin="3,0,0,0" MinWidth="52"
                            Content="{Binding FitLabel}" Tag="{Binding}" Click="OnFitClick"/>
                    <Button Grid.Column="4" Style="{StaticResource RowBtn}" Margin="3,0,0,0" MinWidth="40"
                            Content="{Binding MinLabel}" Tag="{Binding}" Click="OnMinClick"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFitted}" Value="True">
                    <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Yellow}"/>
                    <Setter TargetName="Px" Property="Background" Value="{DynamicResource Yellow}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMinimized}" Value="True">
                    <Setter TargetName="Row" Property="Opacity" Value="0.55"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="Name" Property="FontWeight" Value="Bold"/>
                    <Setter TargetName="TopBtn" Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <!-- 불투명 창: 투명 창은 그릴 때마다 CPU 로 합성되므로 쓰지 않는다. 8px 그림자는 오버레이가 패널 뒤에 그린다 -->
    <!-- 내용은 항상 디자인 크기(폭 440 · 높이 1080, DIP)로 배치하고, 코드에서 LayoutTransform 으로 같은 비율로 키우거나 줄인다 (ApplyPanelScale).
         키워서 화면 바닥을 넘으면 창은 바닥까지만 쓰고 이 ScrollViewer 로 패널 전체를 세로 스크롤한다.
         창 목록 위에서 휠을 굴리면 목록이, 그 밖에서는 패널 전체가 스크롤된다 (안쪽 ScrollViewer 가 휠을 먼저 받음). -->
    <ScrollViewer x:Name="PanelScroll" Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
        <ScrollViewer.Template>
            <ControlTemplate TargetType="ScrollViewer">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ScrollContentPresenter CanContentScroll="{TemplateBinding CanContentScroll}"/>
                    <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Style="{StaticResource PanelScrollBar}"
                               Value="{TemplateBinding VerticalOffset}" Maximum="{TemplateBinding ScrollableHeight}"
                               ViewportSize="{TemplateBinding ViewportHeight}"
                               Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                </Grid>
            </ControlTemplate>
        </ScrollViewer.Template>
    <Border x:Name="Root" Width="440" Height="1080" HorizontalAlignment="Left" VerticalAlignment="Top"
            Background="{DynamicResource Scanlines}" BorderBrush="{DynamicResource TealDeep}" BorderThickness="{DynamicResource EdgeW}">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- 머리 -->
                <RowDefinition Height="Auto"/>   <!-- 녹화 -->
                <RowDefinition Height="Auto"/>   <!-- 녹화 영역 -->
                <RowDefinition Height="Auto"/>   <!-- 대본 -->
                <RowDefinition Height="*"/>      <!-- 창 맞추기: 남는 높이 전부 -->
                <RowDefinition Height="Auto"/>   <!-- 소리 -->
                <RowDefinition Height="Auto"/>   <!-- 알림 -->
                <RowDefinition Height="Auto"/>   <!-- 마지막 메시지 -->
                <RowDefinition Height="Auto"/>   <!-- 단축키 -->
            </Grid.RowDefinitions>

            <!-- 머리 칸: 로고 · 테마 · 크기 · 상태 · 닫기. 빈 곳을 끌면 녹화 영역과 패널이 함께 움직임 -->
            <Border x:Name="Header" Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource TealDeep}"
                    BorderThickness="{DynamicResource EdgeW}" Padding="6,4" Margin="0,0,4,8" Cursor="SizeAll"
                    ToolTip="끌어서 녹화 영역 옮기기"
                    MouseLeftButtonDown="OnHeaderDown" MouseMove="OnHeaderMove"
                    MouseLeftButtonUp="OnHeaderUp" LostMouseCapture="OnHeaderLost">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Image Source="Assets/logo.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    <!-- 이동 아이콘: 테마와 크기 버튼 사이 빈 곳 가운데, 네모 칸 안 4방향 화살표 십자.
                         버튼이 아니라서 누르면 머리 칸의 OnHeaderDown 으로 올라가 영역이 끌린다 -->
                    <Border x:Name="DragGrip" Grid.Column="1" Margin="134,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Width="24" Height="24" Background="{DynamicResource BgRaised}" BorderBrush="{DynamicResource Edge}"
                            BorderThickness="{DynamicResource EdgeW}" Cursor="SizeAll" ToolTip="끌어서 녹화 영역 옮기기">
                        <Path Width="14" Height="14" Stretch="Uniform" SnapsToDevicePixels="True"
                              Data="F1 M8,0 L11.5,3.5 L9,3.5 L9,7 L12.5,7 L12.5,4.5 L16,8 L12.5,11.5 L12.5,9 L9,9 L9,12.5 L11.5,12.5 L8,16 L4.5,12.5 L7,12.5 L7,9 L3.5,9 L3.5,11.5 L0,8 L3.5,4.5 L3.5,7 L7,7 L7,3.5 L4.5,3.5 Z">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Fill" Value="{DynamicResource Muted}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource Cream}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Border>
                    <!-- 테마: 시그니처(픽셀) / 심플테마(차분). 누르면 바로 바뀐다. 이 안을 눌러도 영역이 끌려가지 않게 막는다 -->
                    <Border x:Name="ThemeBox" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0"
                            BorderBrush="{DynamicResource Edge}" BorderThickness="{DynamicResource EdgeW}"
                            Background="Transparent" Cursor="Arrow" MouseLeftButtonDown="OnHeaderToolDown"
                            ToolTip="화면 테마. 바로 바뀌고, 다음에 켤 때도 그대로입니다">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ThemeSignature" GroupName="theme" Style="{StaticResource SegSm}" MinHeight="22" Padding="7,0"
                                         FontFamily="{StaticResource KoFont}" FontSize="11" Content="시그니처" Checked="OnThemeChecked"
                                         ToolTip="시그니처: 픽셀 글꼴 · 주사선 배경 · teal 강조"/>
                            <RadioButton x:Name="ThemeSimple" GroupName="theme" Style="{StaticResource SegSm}" MinHeight="22" Padding="7,0"
                                         FontFamily="{StaticResource KoFont}" FontSize="11" Content="심플테마" Checked="OnThemeChecked"
                                         ToolTip="심플테마: 일반 글꼴 · 단색 배경 · 얇은 테두리"/>
                        </StackPanel>
                    </Border>
                    <!-- 패널 크기: - / + (70~150%). 이 안을 눌러도 영역이 끌려가지 않게 막는다 -->
                    <StackPanel x:Name="ZoomBox" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0"
                                Background="Transparent" Cursor="Arrow" MouseLeftButtonDown="OnHeaderToolDown"
                                ToolTip="패널 크기 (Windows 배율과 상관없이 100% = 높이 1080 픽셀). 화면보다 길어지면 스크롤">
                        <Button x:Name="ZoomOutBtn" Style="{StaticResource IconBtn}" Content="-" MinHeight="24" MinWidth="24"
                                FontSize="{DynamicResource PxS}" ToolTip="패널 작게" Click="OnZoomOut"/>
                        <TextBlock x:Name="ZoomText" FontFamily="{DynamicResource PixelFont}" FontSize="{DynamicResource TxHead}" Width="44"
                                   TextAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" Text="100%"/>
                        <Button x:Name="ZoomInBtn" Style="{StaticResource IconBtn}" Content="+" MinHeight="24" MinWidth="24"
                                FontSize="{DynamicResource PxS}" ToolTip="패널 크게" Click="OnZoomIn"/>
                    </StackPanel>
                    <!-- 상태 칩: READY teal · REC danger · PAUSE yellow -->
                    <Border x:Name="StateChip" Grid.Column="3" Background="{DynamicResource Teal}" Padding="6,4" VerticalAlignment="Center">
                        <TextBlock x:Name="StateText" FontFamily="{DynamicResource PixelFont}" FontSize="{DynamicResource TxHead}"
                                   Foreground="{DynamicResource OnAccent}" Text="READY"/>
                    </Border>
                    <Button Grid.Column="4" Style="{StaticResource IconBtn}" Content="X" Margin="6,0,0,0" MinHeight="24" MinWidth="24"
                            FontSize="{DynamicResource PxS}" ToolTip="끄기 (녹화 중이면 저장을 마치고 끕니다)" Click="OnCloseClick"/>
                </Grid>
            </Border>

            <!-- 녹화: 버튼 · 시간 · 저장 폴더 -->
            <ContentControl x:Name="RecCard" Grid.Row="1" Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="RecBtn" Style="{StaticResource RecBtn}" Width="50" Height="50" FontSize="{DynamicResource PxM}" Content="REC"
                                Click="OnRecClick" ToolTip="녹화 시작 / 저장"/>
                        <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TimerText" FontFamily="{DynamicResource PixelFont}" FontSize="{DynamicResource PxXXL}" Text="00:00:00"/>
                            <TextBlock x:Name="RecMeta" FontFamily="{StaticResource CodeFont}" FontSize="{DynamicResource TxMeta}"
                                       Foreground="{DynamicResource Muted}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button x:Name="PauseBtn" Grid.Column="2" Style="{StaticResource Btn}" Content="II" MinWidth="36" MinHeight="36"
                                FontFamily="{DynamicResource PixelFont}" FontWeight="Normal" FontSize="{DynamicResource PxS}"
                                IsEnabled="False" Click="OnPauseClick" ToolTip="잠깐 멈춤 / 이어서" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid x:Name="FolderRow" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="FolderText" FontFamily="{StaticResource CodeFont}" FontSize="{DynamicResource TxMeta}" Foreground="{DynamicResource Muted}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <Button x:Name="FolderBtn" Grid.Column="1" Style="{StaticResource BtnSm}" Content="변경" Margin="6,0,0,0"
                                Click="OnFolderClick" ToolTip="저장 폴더 바꾸기"/>
                        <Button Grid.Column="2" Style="{StaticResource BtnSm}" Content="열기" Margin="4,0,0,0"
                                Click="OnOpenFolderClick" ToolTip="저장 폴더 열기"/>
                    </Grid>
                </StackPanel>
            </ContentControl>

            <!-- 녹화 영역: 해상도 · fps · 바깥 가림 · 위치 -->
            <ContentControl x:Name="AreaCard" Grid.Row="2" Style="{StaticResource Card}" Margin="0,8,4,4">
                <StackPanel>
                    <Grid>
                        <TextBlock Style="{StaticResource CardTitle}" FontSize="{DynamicResource TxTitle}"><Run Foreground="{DynamicResource Teal}" Text="&gt; "/>REC AREA</TextBlock>
                        <Border BorderBrush="{DynamicResource Edge}" BorderThickness="{DynamicResource EdgeW}" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="Fps30" GroupName="fps" Style="{StaticResource SegSm}" ToolTip="초당 30프레임" Checked="OnFpsChecked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="30"/>
                                        <TextBlock Text="fps" FontFamily="{StaticResource CodeFont}" FontSize="{DynamicResource TxUnit}" Opacity="0.8" Margin="2,0,0,0" VerticalAlignment="Bottom"/>
                                    </StackPanel>
                                </RadioButton>
                                <Border Width="2" Background="{DynamicResource Edge}"/>
                                <RadioButton x:Name="Fps60" GroupName="fps" Style="{StaticResource SegSm}" ToolTip="초당 60프레임" Checked="OnFpsChecked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="60"/>
                                        <TextBlock Text="fps" FontFamily="{StaticResource CodeFont}" FontSize="{DynamicResource TxUnit}" Opacity="0.8" Margin="2,0,0,0" VerticalAlignment="Bottom"/>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <!-- 해상도: 이름 아래 작은 글씨로 실제 크기 -->
                    <Border BorderBrush="{DynamicResource Edge}" BorderThickness="{DynamicResource EdgeW}" Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="2"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="2"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="Res720Btn" GroupName="res" Style="{StaticResource SegSm}" Tag="720" Padding="0,0" Checked="OnPresetChecked">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="720p" VerticalAlignment="Center"/>
                                    <TextBlock Text="1280×720" FontFamily="{StaticResource CodeFont}" FontSize="{DynamicResource TxUnit}" Opacity="0.8" VerticalAlignment="Center" Margin="5,1,0,0"/>
                                </StackPanel>
                            </RadioButton>
                            <Border Grid.Column="1" Background="{DynamicResource Edge}"/>
                            <RadioButton x:Name="HdBtn" Grid.Column="2" GroupName="res" Style="{StaticResource SegSm}" Tag="HD" Padding="0,0" Checked="OnPresetChecked">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="HD" VerticalAlignment="Center"/>
                                    <TextBlock Text="1920×1080" FontFamily="{StaticResource CodeFont}" FontSize="{DynamicResource TxUnit}" Opacity="0.8" VerticalAlignment="Center" Margin="5,1,0,0"/>
                                </StackPanel>
                            </RadioButton>
                            <Border Grid.Column="3" Background="{DynamicResource Edge}"/>
                            <RadioButton x:Name="QhdBtn" Grid.Column="4" GroupName="res" Style="{StaticResource SegSm}" Tag="QHD" Padding="0,0" Checked="OnPresetChecked">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="QHD" VerticalAlignment="Center"/>
                                    <TextBlock Text="2560×1440" FontFamily="{StaticResource CodeFont}" FontSize="{DynamicResource TxUnit}" Opacity="0.8" VerticalAlignment="Center" Margin="5,1,0,0"/>
                                </StackPanel>
                            </RadioButton>
                        </Grid>
                    </Border>
                    <!-- 바깥 가림 · 위치 한 줄 -->
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Label}" Text="밖 가림" Margin="0,0,8,0"/>
                        <Slider x:Name="DimSlider" Grid.Column="1" Style="{StaticResource PixelSlider}" Minimum="0" Maximum="90"
                                SmallChange="5" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="5"
                                ValueChanged="OnDimChanged" ToolTip="녹화되지 않는 바깥 화면을 얼마나 어둡게 가릴지"/>
                        <TextBlock x:Name="DimText" Grid.Column="2" Style="{StaticResource Tag}" FontSize="{DynamicResource TxNum}" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="PosText" Grid.Column="3" Style="{StaticResource Tag}" FontSize="{DynamicResource TxNum}" Foreground="{DynamicResource Muted}"
                                   Margin="12,0,6,0" ToolTip="녹화 영역 위치 (화면 왼쪽 위 기준). 머리 칸을 끌어서 옮깁니다"/>
                        <Button x:Name="ResetPosBtn" Grid.Column="4" Style="{StaticResource BtnSm}" Content="0,0" MinWidth="40"
                                FontFamily="{DynamicResource PixelFont}" FontWeight="Normal" FontSize="{DynamicResource PxXS}"
                                Click="OnResetPosition" ToolTip="녹화 영역을 화면 왼쪽 위 (0,0)으로"/>
                    </Grid>
                </StackPanel>
            </ContentControl>

            <!-- 대본: 자주 쓰는 것만. 불러오기·편집·위치·크기·넘김 기준은 톱니(편집 창)에서 -->
            <ContentControl x:Name="ScriptCard" Grid.Row="3" Style="{StaticResource Card}" Margin="0,8,4,4">
                <StackPanel>
                    <Grid>
                        <TextBlock Style="{StaticResource CardTitle}" FontSize="{DynamicResource TxTitle}"><Run Foreground="{DynamicResource Teal}" Text="&gt; "/>SCRIPT</TextBlock>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="ScriptShowBtn" Style="{StaticResource BtnSm}" MinWidth="72"
                                    Click="OnScriptShow" ToolTip="대본 보이기 / 숨기기 (Ctrl+Alt+S)"/>
                            <Button Style="{StaticResource GearBtn}" Margin="4,0,0,0" Click="OnScriptEditor"
                                    ToolTip="대본 편집 · 불러오기 · 화면 위치와 크기 · 자동스크롤 기준"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource BtnSm}" Content="&lt;" MinWidth="28" FontFamily="{DynamicResource PixelFont}"
                                FontWeight="Normal" FontSize="{DynamicResource PxS}" Click="OnScriptPrev" ToolTip="이전 줄 (Ctrl+Alt+B)"/>
                        <TextBlock x:Name="ScriptCounter" Grid.Column="1" Style="{StaticResource Tag}" FontSize="{DynamicResource TxNum}" Margin="8,0" Text="0 / 0"/>
                        <Button Grid.Column="2" Style="{StaticResource BtnSm}" Content="&gt;" MinWidth="28" FontFamily="{DynamicResource PixelFont}"
                                FontWeight="Normal" FontSize="{DynamicResource PxS}" Click="OnScriptNext" ToolTip="다음 줄 (Ctrl+Alt+N)"/>
                        <Button x:Name="VoiceBtn" Grid.Column="4" Style="{StaticResource BtnSm}" MinWidth="92" Click="OnVoiceToggle"/>
                    </Grid>
                </StackPanel>
            </ContentControl>

            <!-- 창 맞추기: 남는 높이를 모두 목록에 -->
            <ContentControl x:Name="FitCard" Grid.Row="4" Style="{StaticResource Card}" Margin="0,8,4,4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource CardTitle}" FontSize="{DynamicResource TxTitle}"><Run Foreground="{DynamicResource Teal}" Text="&gt; "/>WINDOW FIT</TextBlock>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="NoCaptionBtn" Style="{StaticResource BtnSm}" Content="제목 표시줄 빼기" Click="OnNoCaptionClick"/>
                            <Button x:Name="HideMinBtn" Style="{StaticResource BtnSm}" Margin="4,0,0,0" Click="OnHideMinClick"
                                    ToolTip="최소화된(비활성) 창을 목록에서 숨기기 / 보이기"/>
                            <Button Style="{StaticResource IconBtn}" Content="&#x21BB;" Margin="4,0,0,0" MinHeight="26" MinWidth="28" Padding="0"
                                    FontFamily="Segoe UI Symbol" FontSize="14" ToolTip="새로고침" Click="OnRefreshClick"/>
                        </StackPanel>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <StackPanel>
                            <ItemsControl x:Name="WinList" ItemTemplate="{StaticResource WinRow}" Margin="0,0,4,0"/>
                            <TextBlock x:Name="EmptyText" Style="{StaticResource Label}" Text="맞출 창이 없습니다." Visibility="Collapsed"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </ContentControl>

            <!-- 소리: 장치 줄 아래에 음량 막대 · 상태 -->
            <ContentControl x:Name="AudioCard" Grid.Row="5" Style="{StaticResource Card}" Margin="0,8,4,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.ColumnSpan="3" Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource CardTitle}" FontSize="{DynamicResource TxTitle}"><Run Foreground="{DynamicResource Teal}" Text="&gt; "/>AUDIO</TextBlock>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="FxLabel" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" Padding="0,0,4,0" ToolTip="마이크 다듬기 프리셋"/>
                            <Button x:Name="AudioGear" Style="{StaticResource GearBtn}" Click="OnAudioSettings"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="시스템"/>
                    <ComboBox x:Name="SysCombo" Grid.Row="1" Grid.Column="1" Style="{StaticResource Combo}" SelectionChanged="OnSysDeviceChanged"
                              ToolTip="녹화할 소리가 나오는 장치"/>
                    <Button x:Name="SysToggle" Grid.Row="1" Grid.Column="2" Style="{StaticResource OnOff}" Margin="6,0,0,0"
                            Click="OnSysToggle" ToolTip="녹화에 시스템 소리 넣기 / 빼기"/>
                    <Grid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="86"/>
                        </Grid.ColumnDefinitions>
                        <local:LevelMeter x:Name="SysMeter" Height="12" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SysState" Grid.Column="1" Style="{StaticResource Tag}" FontSize="{DynamicResource TxState}" Foreground="{DynamicResource Teal}" HorizontalAlignment="Right"/>
                    </Grid>

                    <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="마이크" Margin="0,8,0,0"/>
                    <ComboBox x:Name="MicCombo" Grid.Row="3" Grid.Column="1" Style="{StaticResource Combo}" Margin="0,8,0,0"
                              SelectionChanged="OnMicDeviceChanged" ToolTip="목소리를 받을 입력 장치"/>
                    <Button x:Name="MicToggle" Grid.Row="3" Grid.Column="2" Style="{StaticResource OnOff}" Margin="6,8,0,0"
                            Click="OnMicToggle" ToolTip="녹화에 마이크 넣기 / 빼기"/>
                    <Grid Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="86"/>
                        </Grid.ColumnDefinitions>
                        <local:LevelMeter x:Name="MicMeter" Height="12" VerticalAlignment="Center"/>
                        <TextBlock x:Name="MicState" Grid.Column="1" Style="{StaticResource Tag}" FontSize="{DynamicResource TxState}" Foreground="{DynamicResource Teal}" HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- 모니터링: 내 목소리를 헤드셋으로 듣기 (녹화하는 장치와 다른 장치로만). 상태는 버튼 글자로 -->
                    <TextBlock Grid.Row="5" Style="{StaticResource Label}" Text="모니터" Margin="0,8,0,0"/>
                    <ComboBox x:Name="MonCombo" Grid.Row="5" Grid.Column="1" Style="{StaticResource Combo}" Margin="0,8,0,0"
                              SelectionChanged="OnMonDeviceChanged"
                              ToolTip="내 목소리를 들을 장치 (헤드셋). 녹화하는 시스템 소리 장치와 달라야 합니다"/>
                    <Button x:Name="MonToggle" Grid.Row="5" Grid.Column="2" Style="{StaticResource OnOff}" Margin="6,8,0,0"
                            Click="OnMonToggle"/>
                </Grid>
            </ContentControl>

            <!-- 알림: 상태 표시만으로는 이유를 알 수 없는 것만 -->
            <ItemsControl x:Name="Alerts" Grid.Row="6">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,8,4,0" Padding="8,5" BorderThickness="2" Background="{DynamicResource Bg}"
                                BorderBrush="{Binding Color}">
                            <TextBlock Style="{StaticResource Body}" FontSize="12">
                                <Run FontFamily="{DynamicResource PixelFont}" FontSize="{DynamicResource PxXS}" Foreground="{Binding Color, Mode=OneWay}"
                                     Text="{Binding Tag, Mode=OneWay}"/><Run Text="{Binding Message, Mode=OneWay}"/>
                            </TextBlock>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 마지막 동작 결과 (한 곳에만) -->
            <TextBlock x:Name="StatusText" Grid.Row="7" FontSize="12" Margin="0,8,0,0"
                       TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis" Visibility="Collapsed">
                <Run x:Name="StatusTag" FontFamily="{DynamicResource PixelFont}" FontSize="{DynamicResource PxXS}"/><Run x:Name="StatusMsg"/>
            </TextBlock>

            <!-- 단축키: 패널 안에서 이곳에만 -->
            <TextBlock x:Name="ShortcutText" Grid.Row="8" FontFamily="{StaticResource CodeFont}" FontSize="{DynamicResource TxKeys}" Foreground="{DynamicResource Muted}" Margin="0,8,0,0">
                <Run Foreground="{DynamicResource Teal}" Text="Ctrl+Alt"/> + R 녹화 · P 멈춤 · F 맞추기 · M 최소화
                <LineBreak/><Run Foreground="{DynamicResource Teal}" Text="Ctrl+Alt"/> + S 대본 · N 다음 줄 · B 이전 줄
            </TextBlock>
        </Grid>
    </Border>
    </ScrollViewer>
</Window>
