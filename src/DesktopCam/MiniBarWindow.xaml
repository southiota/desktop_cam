<Window x:Class="DesktopCam.MiniBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DesktopCam"
        Title="Desktop CAM Mini"
        WindowStyle="None" ResizeMode="NoResize" SizeToContent="Height" Width="140"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False" Background="{DynamicResource BgPanel}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
    <!-- 패널을 닫았을 때 패널 왼쪽 위 자리에 뜨는 작은 바: 녹화 · 대본 넘기기 · 펜 · 소리. 녹화에 찍히지 않고 포커스를 가져가지 않는다.
         버튼 아래 숫자 = 단축키 (줄 제목 오른쪽의 Ctrl+Alt+ 와 같이. 펜 · 형광펜 중에는 숫자만) -->
    <Window.Resources>
        <Style x:Key="MiniBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="0,4"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="MiniLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource PixelFont}"/>
            <Setter Property="FontSize" Value="{DynamicResource PxXS}"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- 줄 제목 오른쪽의 "Ctrl+Alt+" -->
        <Style x:Key="ModKeys" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource CodeFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource Teal}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Text" Value="Ctrl+Alt+"/>
        </Style>
        <!-- 버튼 안 아이콘 아래 단축키 숫자 (아이콘 폭만 한 크기) -->
        <Style x:Key="KeyText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource CodeFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="Opacity" Value="0.7"/>
        </Style>
        <!-- 아이콘: 직접 그린 벡터(24×24). 선 · 채움 색은 버튼 글자색(테마 색)을 따른다 -->
        <Style x:Key="IconBox" TargetType="Viewbox">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="IconLine" TargetType="Path">
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            <Setter Property="StrokeThickness" Value="1.8"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
        </Style>
        <Style x:Key="IconFill" TargetType="Path">
            <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        </Style>
    </Window.Resources>
    <Border BorderBrush="{DynamicResource TealDeep}" BorderThickness="{DynamicResource EdgeW}" Padding="4">
        <StackPanel>
            <!-- 머리: [패널 열기] · 녹화 상태(녹화 중에만 REC · PAUSE) · 이동(녹화 영역 · 패널 함께) -->
            <Grid Margin="2,0,2,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="ExpandBtn" Style="{StaticResource MiniBtn}" Content="패널 열기" Margin="0" MinHeight="26" Height="26" Padding="7,0"
                        FontFamily="{StaticResource KoFont}" FontSize="11" Click="OnExpand" ToolTip="패널 다시 열기"/>
                <TextBlock x:Name="StateText" Grid.Column="1" Style="{StaticResource MiniLabel}" Foreground="{DynamicResource Danger}" HorizontalAlignment="Center"/>
                <Border x:Name="Grip" Grid.Column="2" Width="26" Height="26" Background="{DynamicResource BgRaised}"
                        BorderBrush="{DynamicResource Edge}" BorderThickness="{DynamicResource EdgeW}" Cursor="SizeAll"
                        ToolTip="끌어서 녹화 영역 옮기기 (패널 · 이 바도 같이)"
                        MouseLeftButtonDown="OnGripDown" MouseMove="OnGripMove" MouseLeftButtonUp="OnGripUp" LostMouseCapture="OnGripLost">
                    <Path Width="14" Height="14" Stretch="Uniform" SnapsToDevicePixels="True"
                          Data="F1 M8,0 L11.5,3.5 L9,3.5 L9,7 L12.5,7 L12.5,4.5 L16,8 L12.5,11.5 L12.5,9 L9,9 L9,12.5 L11.5,12.5 L8,16 L4.5,12.5 L7,12.5 L7,9 L3.5,9 L3.5,11.5 L0,8 L3.5,4.5 L3.5,7 L7,7 L7,3.5 L4.5,3.5 Z">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Fill" Value="{DynamicResource Muted}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource Cream}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Border>
            </Grid>

            <!-- 녹화 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="34"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="RecBtn" Style="{StaticResource MiniBtn}" Foreground="{DynamicResource Danger}" Height="30" Padding="0"
                        FontFamily="{DynamicResource PixelFont}" FontSize="{DynamicResource PxS}" Content="REC"
                        Click="OnRec" ToolTip="녹화 시작 / 저장 (Ctrl+Alt+R)"/>
                <Button x:Name="PauseBtn" Grid.Column="1" Style="{StaticResource MiniBtn}" IsEnabled="False" Height="30" Padding="0"
                        FontFamily="{DynamicResource PixelFont}" FontSize="{DynamicResource PxS}" Content="II"
                        Click="OnPause" ToolTip="멈춤 / 다시 (Ctrl+Alt+P)"/>
            </Grid>
            <TextBlock x:Name="TimerText" Style="{StaticResource MiniLabel}" HorizontalAlignment="Center" Margin="0,2,0,4" Text="00:00:00"/>

            <!-- 대본 넘기기 -->
            <StackPanel Orientation="Horizontal" Margin="2,2,0,0">
                <TextBlock Style="{StaticResource MiniLabel}" Text="SCRIPT"/>
                <TextBlock Style="{StaticResource ModKeys}"/>
            </StackPanel>
            <UniformGrid Columns="2">
                <Button x:Name="PrevBtn" Style="{StaticResource MiniBtn}" Click="OnPrev" ToolTip="대본 이전 줄 (Ctrl+Alt+9 · Ctrl+Alt+B, 펜 · 형광펜 중에는 9)">
                    <StackPanel>
                        <TextBlock Text="&lt;" FontFamily="{DynamicResource PixelFont}" FontSize="{DynamicResource PxS}" HorizontalAlignment="Center" Height="22" Padding="0,5,0,0"/>
                        <TextBlock Style="{StaticResource KeyText}" Text="9"/>
                    </StackPanel>
                </Button>
                <Button x:Name="NextBtn" Style="{StaticResource MiniBtn}" Click="OnNext" ToolTip="대본 다음 줄 (Ctrl+Alt+0 · Ctrl+Alt+N, 펜 · 형광펜 중에는 0)">
                    <StackPanel>
                        <TextBlock Text="&gt;" FontFamily="{DynamicResource PixelFont}" FontSize="{DynamicResource PxS}" HorizontalAlignment="Center" Height="22" Padding="0,5,0,0"/>
                        <TextBlock Style="{StaticResource KeyText}" Text="0"/>
                    </StackPanel>
                </Button>
            </UniformGrid>

            <!-- 펜 -->
            <StackPanel Orientation="Horizontal" Margin="2,6,0,0">
                <TextBlock Style="{StaticResource MiniLabel}" Text="PEN"/>
                <TextBlock Style="{StaticResource ModKeys}"/>
            </StackPanel>
            <UniformGrid Columns="3">
                <Button x:Name="CursorBtn" Style="{StaticResource MiniBtn}" Tag="1" Click="OnTool" ToolTip="커서: 그림은 남기고 클릭은 아래 창으로 (Ctrl+Alt+1)">
                    <StackPanel>
                        <Viewbox Style="{StaticResource IconBox}">
                            <Canvas Width="24" Height="24">
                                <!-- 마우스: 몸통 · 왼쪽 버튼(옅게 채움) · 가운데 선 · 휠 -->
                                <Path Style="{StaticResource IconFill}" Opacity="0.3" Data="M12,2.5 C8.4,2.5 5.5,5.4 5.5,9 L5.5,10 L12,10 Z"/>
                                <Path Style="{StaticResource IconLine}" Data="M12,2.5 C8.4,2.5 5.5,5.4 5.5,9 L5.5,15 C5.5,18.6 8.4,21.5 12,21.5 C15.6,21.5 18.5,18.6 18.5,15 L18.5,9 C18.5,5.4 15.6,2.5 12,2.5 Z M5.5,10 L18.5,10 M12,2.5 L12,10"/>
                                <Rectangle Canvas.Left="10.6" Canvas.Top="4.6" Width="2.8" Height="4" RadiusX="1.4" RadiusY="1.4"
                                           Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Style="{StaticResource KeyText}" Text="1"/>
                    </StackPanel>
                </Button>
                <Button x:Name="PenBtn" Style="{StaticResource MiniBtn}" Tag="2" Click="OnTool" ToolTip="펜: 실선 (Ctrl+Alt+2)">
                    <StackPanel>
                        <Viewbox Style="{StaticResource IconBox}">
                            <Canvas Width="24" Height="24">
                                <!-- 실선: 부드러운 S 곡선 + 끝점 -->
                                <Path Style="{StaticResource IconLine}" StrokeThickness="2.6" Data="M3.5,18 C6.5,9.5 9.5,9 12,13.5 C14.5,18 17.5,17.5 20.5,7.5"/>
                                <Ellipse Canvas.Left="1.6" Canvas.Top="16.1" Width="3.8" Height="3.8"
                                         Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Style="{StaticResource KeyText}" Text="2"/>
                    </StackPanel>
                </Button>
                <Button x:Name="HiBtn" Style="{StaticResource MiniBtn}" Tag="3" Click="OnTool" ToolTip="형광펜 (Ctrl+Alt+3)">
                    <StackPanel>
                        <Viewbox Style="{StaticResource IconBox}">
                            <Canvas Width="24" Height="24">
                                <!-- 형광선: 글 줄 셋 중 가운데 줄 위에 반투명한 굵은 띠 -->
                                <Path Style="{StaticResource IconLine}" Opacity="0.55" StrokeThickness="1.6" Data="M4,5.5 L20,5.5 M4,18.5 L15,18.5"/>
                                <Rectangle Canvas.Left="2.5" Canvas.Top="8.5" Width="19" Height="7" RadiusX="1" RadiusY="1" Opacity="0.45"
                                           Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <Path Style="{StaticResource IconLine}" StrokeThickness="1.8" Data="M4,12 L20,12"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Style="{StaticResource KeyText}" Text="3"/>
                    </StackPanel>
                </Button>
                <Button x:Name="ColorBtn" Style="{StaticResource MiniBtn}" Tag="4" Click="OnTool" ToolTip="색 고르기 (Ctrl+Alt+4)">
                    <StackPanel>
                        <!-- 원형 팔레트: 360도 256색 색상환(가운데는 흰색으로 옅어짐) + 테두리 -->
                        <Grid Width="19" Height="19">
                            <Image x:Name="WheelImage" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <Ellipse StrokeThickness="1.2" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Grid>
                        <Border x:Name="ColorSwatch" Width="20" Height="3"/>   <!-- 지금 색 (오피스 글꼴 색 버튼처럼) -->
                        <TextBlock Style="{StaticResource KeyText}" Text="4"/>
                    </StackPanel>
                </Button>
                <Button x:Name="ClearBtn" Style="{StaticResource MiniBtn}" Tag="5" Click="OnTool" ToolTip="전부 지우기 (Ctrl+Alt+5)">
                    <StackPanel>
                        <Viewbox Style="{StaticResource IconBox}">
                            <Canvas Width="24" Height="24">
                                <!-- 지우개: 기울어진 몸통 · 지우는 끝(옅게 채움) · 바닥 선 -->
                                <Path Style="{StaticResource IconFill}" Opacity="0.45" Data="M5,13 L9,9 L15,15 L11,19 Z"/>
                                <Path Style="{StaticResource IconLine}" Data="M15,3 L21,9 L11,19 L5,13 Z M9,9 L15,15 M11,21.2 L20.5,21.2"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Style="{StaticResource KeyText}" Text="5"/>
                    </StackPanel>
                </Button>
            </UniformGrid>

            <!-- 소리 -->
            <TextBlock Style="{StaticResource MiniLabel}" Text="AUDIO" Margin="2,6,0,2"/>
            <Grid Margin="2,0,2,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource MiniLabel}" Text="SYS"/>
                <local:LevelMeter x:Name="SysMeter" Grid.Column="1" Height="10" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="1" Style="{StaticResource MiniLabel}" Text="MIC" Margin="0,6,0,0"/>
                <local:LevelMeter x:Name="MicMeter" Grid.Row="1" Grid.Column="1" Height="10" VerticalAlignment="Center" Margin="0,6,0,0"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
