<Window x:Class="DesktopCam.InkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop CAM Ink"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        UseLayoutRounding="True">
    <!-- 녹화 영역을 덮는 그림 창. 펜 · 형광펜 자국은 녹화에 찍힌다.
         커서 모드: 클릭 통과(그림은 남음). 펜 · 형광펜 모드: 마우스를 받아 그린다 -->
    <InkCanvas x:Name="Ink" Background="Transparent" EditingMode="None"/>
</Window>
