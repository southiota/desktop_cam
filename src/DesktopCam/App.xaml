<Application x:Class="DesktopCam.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
        <!-- 색 · 픽셀 서체 · 배경은 테마 사전에 있다 (Themes\Signature.xaml / Simple.xaml). Theme.cs 가 실행 중에 바꿔 끼운다.
             그래서 테마에 따라 바뀌는 키는 어디서나 DynamicResource 로 쓴다. -->
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="Themes/Signature.xaml"/>
        </ResourceDictionary.MergedDictionaries>

        <!-- 테마와 상관없는 서체 -->
        <FontFamily x:Key="KoFont">Noto Sans KR, Malgun Gothic</FontFamily>
        <FontFamily x:Key="CodeFont">JetBrains Mono, D2Coding, Consolas</FontFamily>

        <!-- 카드: bg-panel + 테두리(시그니처 teal 2px · 심플 회색 1px) + 4px 밀어낸 그림자(심플은 없음) -->
        <Style x:Key="Card" TargetType="ContentControl">
            <Setter Property="Margin" Value="0,0,4,4"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid>
                            <Border Background="{DynamicResource CardShadow}" Margin="4,4,-4,-4"/>
                            <Border Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource Edge}"
                                    BorderThickness="{DynamicResource EdgeW}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 카드 제목 "> AREA" -->
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource PixelFont}"/>
            <Setter Property="FontSize" Value="{DynamicResource PxS}"/>
            <Setter Property="Foreground" Value="{DynamicResource Cream}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="KeyHint" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource CodeFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource KoFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource Cream}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- 보조 버튼: bg-raised + teal 테두리, 호버 시 노란 글자, 누르면 2px 눌림 -->
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Cream}"/>
            <Setter Property="FontFamily" Value="{StaticResource KoFont}"/>
            <Setter Property="FontWeight" Value="{DynamicResource BtnWeight}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{DynamicResource BgRaised}" BorderBrush="{DynamicResource Edge}"
                                BorderThickness="{DynamicResource EdgeW}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="RenderTransform">
                                    <Setter.Value><TranslateTransform X="2" Y="2"/></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 녹화 버튼: 화면에 하나뿐인 면 (시그니처 노랑 + orange 6px 그림자 · 심플 빨강), 누르면 그림자만큼 눌림 -->
        <Style x:Key="RecBtn" TargetType="Button">
            <Setter Property="Width" Value="72"/>
            <Setter Property="Height" Value="72"/>
            <Setter Property="Foreground" Value="{DynamicResource RecText}"/>
            <Setter Property="FontFamily" Value="{DynamicResource PixelFont}"/>
            <Setter Property="FontSize" Value="{DynamicResource PxXL}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Margin="0,0,6,6">
                            <Border x:Name="sh" Background="{DynamicResource RecShadow}" Margin="6,6,-6,-6"/>
                            <Border x:Name="face" Background="{DynamicResource RecFace}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="face" Property="RenderTransform">
                                    <Setter.Value><TranslateTransform X="4" Y="4"/></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="face" Property="BorderBrush" Value="{DynamicResource Cream}"/>
                                <Setter TargetName="face" Property="BorderThickness" Value="3"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 상세 설정 톱니: 아이콘만, 카드 제목 줄 오른쪽 끝 -->
        <Style x:Key="GearBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Content" Value="&#x2699;"/>
        </Style>

        <!-- 작은 텍스트 버튼 (헤더의 닫기 등) -->
        <Style x:Key="IconBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="FontFamily" Value="{DynamicResource PixelFont}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="{DynamicResource PxL}"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="Padding" Value="6,0"/>
        </Style>

        <!-- 선택 묶음 버튼 (HD / QHD, 30 / 60): 선택되면 teal 면 + bg 글자 -->
        <Style x:Key="Seg" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Cream}"/>
            <Setter Property="FontFamily" Value="{DynamicResource PixelFont}"/>
            <Setter Property="FontSize" Value="{DynamicResource PxL}"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" Background="{DynamicResource BgRaised}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Teal}"/>
                                <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 슬라이더: 각진 막대 + cream 손잡이 -->
        <Style x:Key="SliderFill" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="8" Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PixelSlider" TargetType="Slider">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="24" Background="Transparent">
                            <Border Height="12" VerticalAlignment="Center" Background="{DynamicResource Bg}"
                                    BorderBrush="{DynamicResource TealDeep}" BorderThickness="2"/>
                            <Track x:Name="PART_Track" Margin="2,0">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderFill}"
                                                  Background="{DynamicResource Teal}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderFill}"
                                                  Background="Transparent"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="12" Height="22" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{DynamicResource Cream}"
                                                        BorderBrush="{DynamicResource TealDeep}" BorderThickness="0,0,3,3"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 장치 선택 드롭다운: bg-raised + teal 테두리, 펼친 목록도 같은 색 -->
        <Style x:Key="ComboToggle" TargetType="ToggleButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="b" Background="{DynamicResource BgRaised}" BorderBrush="{DynamicResource Edge}" BorderThickness="{DynamicResource EdgeW}">
                            <TextBlock Text="▼" FontSize="9" Foreground="{DynamicResource Teal}" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Cream}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="b" Background="Transparent" Padding="10,7">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource BgPanel}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Teal}"/>
                                <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PixelCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource Cream}"/>
            <Setter Property="FontFamily" Value="{StaticResource KoFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Style="{StaticResource ComboToggle}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" IsHitTestVisible="False"
                                              Margin="10,0,28,0" VerticalAlignment="Center">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="None">
                                <Border Background="{DynamicResource BgRaised}" BorderBrush="{DynamicResource Edge}" BorderThickness="{DynamicResource EdgeW}"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="280">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 스크롤바: 누가 봐도 스크롤바로 보이게. 어두운 홈(트랙) + 밝은 손잡이 + 잡는 줄 3개 + 위/아래 화살표.
             색은 다른 칸(teal 테두리 · 버튼)과 헷갈리지 않게 테마마다 따로 둔다 (ScrollTrack · ScrollThumb …).
             기본 두께 14 (창 목록 · 드롭다운 등). 패널 전체 스크롤바는 PanelWindow 의 PanelScrollBar (약 20). -->
        <Style x:Key="ScrollArrow" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Foreground" Value="{DynamicResource ScrollThumb}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border x:Name="b" Background="{DynamicResource ScrollArrowBg}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource ScrollThumbHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource ScrollThumbDrag}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ScrollGrip}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 홈의 빈 곳: 누르면 한 쪽씩 넘김 -->
        <Style x:Key="ScrollPage" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 손잡이: 마우스 올림 · 끌기에 따라 밝아진다. 가운데 잡는 줄 3개 -->
        <Style x:Key="ScrollThumbV" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="t" Background="{DynamicResource ScrollThumb}" ClipToBounds="True">
                            <StackPanel VerticalAlignment="Center" Margin="3,0">
                                <Rectangle Height="2" Fill="{DynamicResource ScrollGrip}"/>
                                <Rectangle Height="2" Margin="0,2" Fill="{DynamicResource ScrollGrip}"/>
                                <Rectangle Height="2" Fill="{DynamicResource ScrollGrip}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="t" Property="Background" Value="{DynamicResource ScrollThumbHover}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="t" Property="Background" Value="{DynamicResource ScrollThumbDrag}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScrollThumbH" TargetType="Thumb" BasedOn="{StaticResource ScrollThumbV}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="t" Background="{DynamicResource ScrollThumb}" ClipToBounds="True">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,3">
                                <Rectangle Width="2" Fill="{DynamicResource ScrollGrip}"/>
                                <Rectangle Width="2" Margin="2,0" Fill="{DynamicResource ScrollGrip}"/>
                                <Rectangle Width="2" Fill="{DynamicResource ScrollGrip}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="t" Property="Background" Value="{DynamicResource ScrollThumbHover}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="t" Property="Background" Value="{DynamicResource ScrollThumbDrag}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="VScrollTpl" TargetType="ScrollBar">
            <ControlTemplate.Resources>
                <!-- 손잡이 최소 길이 = 이 값의 절반 (WPF Track 규칙). 잡는 줄이 늘 보이게 -->
                <sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarButtonHeightKey}">48</sys:Double>
            </ControlTemplate.Resources>
            <Border Background="{DynamicResource ScrollTrack}" BorderBrush="{DynamicResource ScrollEdge}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <RepeatButton Style="{StaticResource ScrollArrow}" Command="ScrollBar.LineUpCommand"
                                  Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}}">
                        <Path Data="M0,5 L4.5,0 L9,5 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RepeatButton}}"/>
                    </RepeatButton>
                    <Track x:Name="PART_Track" Grid.Row="1" IsDirectionReversed="True" Margin="0,1">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand"/>
                        </Track.DecreaseRepeatButton>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand"/>
                        </Track.IncreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Style="{StaticResource ScrollThumbV}" Margin="1,0"/>
                        </Track.Thumb>
                    </Track>
                    <RepeatButton Grid.Row="2" Style="{StaticResource ScrollArrow}" Command="ScrollBar.LineDownCommand"
                                  Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}}">
                        <Path Data="M0,0 L9,0 L4.5,5 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RepeatButton}}"/>
                    </RepeatButton>
                </Grid>
            </Border>
        </ControlTemplate>
        <ControlTemplate x:Key="HScrollTpl" TargetType="ScrollBar">
            <ControlTemplate.Resources>
                <sys:Double x:Key="{x:Static SystemParameters.HorizontalScrollBarButtonWidthKey}">48</sys:Double>
            </ControlTemplate.Resources>
            <Border Background="{DynamicResource ScrollTrack}" BorderBrush="{DynamicResource ScrollEdge}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <RepeatButton Style="{StaticResource ScrollArrow}" Command="ScrollBar.LineLeftCommand"
                                  Width="{Binding ActualHeight, RelativeSource={RelativeSource Self}}">
                        <Path Data="M5,0 L5,9 L0,4.5 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RepeatButton}}"/>
                    </RepeatButton>
                    <Track x:Name="PART_Track" Grid.Column="1" Margin="1,0">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageLeftCommand"/>
                        </Track.DecreaseRepeatButton>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageRightCommand"/>
                        </Track.IncreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Style="{StaticResource ScrollThumbH}" Margin="0,1"/>
                        </Track.Thumb>
                    </Track>
                    <RepeatButton Grid.Column="2" Style="{StaticResource ScrollArrow}" Command="ScrollBar.LineRightCommand"
                                  Width="{Binding ActualHeight, RelativeSource={RelativeSource Self}}">
                        <Path Data="M0,0 L5,4.5 L0,9 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RepeatButton}}"/>
                    </RepeatButton>
                </Grid>
            </Border>
        </ControlTemplate>

        <!-- 모든 스크롤바 기본 (두께 14) -->
        <Style TargetType="ScrollBar">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="14"/>
            <Setter Property="MinWidth" Value="14"/>
            <Setter Property="Template" Value="{StaticResource VScrollTpl}"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height" Value="14"/>
                    <Setter Property="MinHeight" Value="14"/>
                    <Setter Property="Template" Value="{StaticResource HScrollTpl}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
